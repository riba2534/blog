# Cloudflare Workers Assets 响应头规则
# /scss/* 文件名带 sha256 指纹，内容不可变，可放心缓存一年
/scss/*
  Cache-Control: public, max-age=31536000, immutable

# 主题 JS 无指纹，给 1 天缓存（此前是 max-age=0，每次导航都要发条件请求）
/js/*
  Cache-Control: public, max-age=86400

/vendor/*
  Cache-Control: public, max-age=86400

/favicon.png
  Cache-Control: public, max-age=604800

/favicon.ico
  Cache-Control: public, max-age=604800
