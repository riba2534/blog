{{- printf "<?xml-stylesheet href=\"/rss.xsl\" type=\"text/xsl\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ if eq  .Title  .Site.Title }}{{ .Site.Title }}{{ else }}{{ with .Title }}{{.}} on {{ end }}{{ .Site.Title }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>Recent content {{ if ne  .Title  .Site.Title }}{{ with .Title }}in {{.}} {{ end }}{{ end }}on {{ .Site.Title }}</description>
    <generator>Hugo -- gohugo.io</generator>{{/* Language.Locale 需 Hugo 0.158+，Cloudflare 的 0.147 回退用 .Lang */}}{{ $lang := "" }}{{ if ge hugo.Version "0.158.0" }}{{ $lang = .Site.Language.Locale }}{{ else }}{{ $lang = .Site.Language.Lang }}{{ end }}{{ with $lang }}
    <language>{{.}}</language>{{end}}{{ with .Site.Params.author_email }}
    <managingEditor>{{.}}{{ with $.Site.Params.author_name }} ({{.}}){{end}}</managingEditor>{{end}}{{ with .Site.Params.author_email }}
    <webMaster>{{.}}{{ with $.Site.Params.author_name }} ({{.}}){{end}}</webMaster>{{end}}{{ with .Site.Copyright }}
    <copyright>{{.}}</copyright>{{end}}{{ if not .Date.IsZero }}
    <lastBuildDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>{{ end }}
    {{ with .OutputFormats.Get "RSS" }}
        {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
    {{ end }}
    {{/* 不要用 .Paginator：会让 Hugo 给每个分页目录都生成一份全文 RSS（曾产出 17 份共 9.4MB）。
         首页的 .RegularPages 只含根级页面，必须用 .Site.RegularPages 才能取到 blog 分区的文章 */}}
    {{ range first 20 .Site.RegularPages }}
    {{ if and (.IsPage) (.Params.date) }}
        <item>
        <title>{{ .Title }}</title>
        <link>{{ .Permalink }}</link>
        <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
        {{ with .Site.Params.author_email }}<author>{{.}}{{ with $.Site.Params.author_name }} ({{.}}){{end}}</author>{{end}}
        <guid>{{ .Permalink }}</guid>
        <description>{{ .Site.Title }} {{ .Permalink }} - {{- .Content | html -}} - {{ .Permalink }} - {{.Site.Copyright}}</description>
        </item>
    {{ end }}
    {{ end }}
  </channel>
</rss> 
